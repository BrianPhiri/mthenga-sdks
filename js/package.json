{
  "name": "mthenga",
  "version": "0.1.0",
  "description": "Client for mthenga, a programmatic inbox for AI agents over email, WhatsApp, Messenger and Instagram",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BrianPhiri/mthenga-sdks.git",
    "directory": "js"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test test/client.test.mjs",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
